<script>
const WEBAPP_URL = "WEBAPP_URL_DA_INSERIRE";
const ANNO_MASSIMO = 2018;   // nati nel 2018 o prima
const ALTEZZA_MINIMA = 100;  // cm

let stepCorrente = 0;
const TOTALE_STEP = 3;

let stato = { trovato: false, dati: null };

function vaiStep(n) {
  document.getElementById("step" + stepCorrente).style.display = "none";
  stepCorrente = n;
  document.getElementById("step" + stepCorrente).style.display = "block";
  for (let i = 0; i < TOTALE_STEP; i++) {
    const d = document.getElementById("dot" + i);
    if (!d) continue;
    d.className = "step-dot" + (i < n ? " completato" : i === n ? " attivo" : "");
  }
  window.scrollTo({ top: 0, behavior: "smooth" });
}

function mostraAlert(id, tipo, testo) {
  const el = document.getElementById(id);
  el.className = "alert show-" + tipo;
  el.innerHTML = testo;
}
function nascondiAlert(id) { document.getElementById(id).className = "alert"; }

function annoDaDataNascita(dn) {
  if (!dn) return null;
  const s = dn.toString().trim();
  let m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
  if (m) return parseInt(m[3], 10);
  m = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (m) return parseInt(m[1], 10);
  return null;
}

async function cercaCF() {
  const cf = document.getElementById("cfInput").value.trim().toUpperCase();
  document.getElementById("errCF").textContent = "";
  nascondiAlert("alertCF");
  document.getElementById("bloccoDati").style.display = "none";
  stato = { trovato: false, dati: null };

  if (!cf || cf.length !== 16 || !/^[A-Z0-9]{16}$/.test(cf)) {
    document.getElementById("errCF").textContent = "Il codice fiscale deve essere di 16 caratteri alfanumerici";
    return;
  }

  const btn = document.getElementById("cfBtn");
  btn.textContent = "Ricerca..."; btn.disabled = true;

  try {
    const res  = await fetch(WEBAPP_URL, { method:"POST", body:JSON.stringify({ azione:"cercaIscritto", cf }) });
    const data = await res.json();

    if (!data.ok) {
      mostraAlert("alertCF", "error", "Errore: " + (data.errore || "riprova più tardi"));
      return;
    }

    if (!data.trovato) {
      mostraAlert("alertCF", "error",
        "Questo codice fiscale non risulta iscritto al Grest 2026. La gita è riservata ai partecipanti del Grest. Se pensi ci sia un errore, contattaci.");
      return;
    }

    const d = data.dati;
    const anno = annoDaDataNascita(d.dataNasc);

    if (!anno) {
      mostraAlert("alertCF", "error", "Non riusciamo a leggere la data di nascita. Contattaci per completare l'adesione.");
      return;
    }

    if (anno > ANNO_MASSIMO) {
      mostraAlert("alertCF", "error",
        `Ci dispiace: la gita è riservata ai nati nel <strong>${ANNO_MASSIMO}</strong> o prima. <strong>${d.nome} ${d.cognome}</strong> è nato/a nel <strong>${anno}</strong> e non può partecipare a questa uscita.`);
      return;
    }

    stato.trovato = true;
    stato.dati = { ...d, anno };

    document.getElementById("cognome").value     = d.cognome || "";
    document.getElementById("nome").value        = d.nome || "";
    document.getElementById("annoNascita").value = anno;
    document.getElementById("bloccoDati").style.display = "block";

    mostraAlert("alertCF", "success",
      "✓ Iscritto trovato! Indica l'altezza per completare l'adesione.");

  } catch(e) {
    console.error(e);
    mostraAlert("alertCF", "error", "Errore di connessione. Riprova.");
  } finally {
    btn.textContent = "Verifica"; btn.disabled = false;
  }
}

async function inviaAdesione() {
  const errAlt = document.getElementById("errAltezza");
  const btn = document.getElementById("btnInvia");

  if (!stato.trovato) {
    document.getElementById("errCF").textContent = "Verifica prima il codice fiscale";
    return;
  }

  const alt = parseInt(document.getElementById("altezza").value.trim(), 10);
  if (!alt || isNaN(alt)) { errAlt.textContent = "Indica l'altezza in centimetri"; return; }
  if (alt < ALTEZZA_MINIMA) {
    errAlt.textContent = `L'altezza minima per partecipare è di ${ALTEZZA_MINIMA} cm`;
    return;
  }
  if (alt > 220) { errAlt.textContent = "Controlla il valore inserito"; return; }
  errAlt.textContent = "";

  btn.disabled = true;
  btn.innerHTML = '<span class="spinner"></span> Invio in corso...';

  const payload = {
    azione: "salvaAdesione",
    dati: {
      cf:        stato.dati.cf,
      sesso:     stato.dati.sesso || "",
      cognome:   stato.dati.cognome,
      nome:      stato.dati.nome,
      anno:      stato.dati.anno,
      ruolo:     stato.dati.ruolo || "",
      email:     stato.dati.email || "",
      cellG1:    stato.dati.cellG1 || "",
      nomeG1:    stato.dati.nomeG1 || "",
      cognomeG1: stato.dati.cognomeG1 || "",
      altezza:   alt,
    }
  };

  try {
    const res  = await fetch(WEBAPP_URL, { method:"POST", body:JSON.stringify(payload) });
    const data = await res.json();

    if (data.ok) {
      document.getElementById("nomeConferma").textContent    = `${stato.dati.nome} ${stato.dati.cognome}`;
      document.getElementById("altezzaConferma").textContent = alt + " cm";
      document.getElementById("causaleConferma").textContent = `Gita Jungle ${stato.dati.cognome} ${stato.dati.nome}`;
      document.getElementById("progressBar").style.display = "none";
      vaiStep(2);
    } else {
      mostraAlert("alertCF", "error", "Errore: " + (data.errore || "riprova più tardi"));
      btn.disabled = false; btn.textContent = "Conferma adesione ✓";
    }
  } catch(e) {
    mostraAlert("alertCF", "error", "Errore di connessione. Riprova tra qualche istante.");
    btn.disabled = false; btn.textContent = "Conferma adesione ✓";
  }
}
</script>
</body>
</html>
